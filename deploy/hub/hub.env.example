# /etc/ecomsp/hub.env  (owner root, group ecomsp-hub, mode 0640)
# Identifiers only. Secrets (database password etc.) come from Azure Key Vault or
# ~/.pgpass, never this file.

# PostgreSQL, local socket, no password in the URL (peer auth or ~/.pgpass)
HUB_DATABASE_URL=postgresql:///hub?host=/var/run/postgresql

# Microsoft Entra ID (from the app registration; see docs/IDENTITY.md)
ENTRA_AUDIENCE=api://<application-client-id>
ENTRA_ALLOWED_TENANTS=<tenant-id>[,<subsidiary-tenant-id>...]

# Survey storage on the server: <root>/<tenant-id>/<survey-id>/{cards,review}
HUB_STORAGE_ROOT=/srv/ecomsp/surveys

# The hub's own tamper-evident audit log
BRAIN_AUDIT_DIR=/var/lib/ecomsp/hub-audit

# Optional: Azure Key Vault in UK South
# AZURE_KEYVAULT_URL=https://<vault>.vault.azure.net/

# Optional: off-site backup copies (Azure Storage account in UK South, container
# hub-backups). The server signs in with its Azure Arc managed identity, which needs
# "Storage Blob Data Contributor" on the account.
# BACKUP_STORAGE_ACCOUNT=<storage account name>
