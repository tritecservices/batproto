# ---------------------------------------------------------------- store
BRAIN_DB=data/brain.db
# hash = offline, no key, weakest. local = offline sentence-transformers, recommended.
# openai / azure = best quality, sends text to the provider.
BRAIN_EMBEDDER=local

# ---------------------------------------------------------------- discord
# Bot token from the Developer Portal. NEVER a user token: self-botting breaks ToS.
# Enable the MESSAGE CONTENT privileged intent, and grant Read Message History.
DISCORD_BOT_TOKEN=
# Whitelist. Only these guild ids are ever indexed. Get permission first.
ALLOWED_GUILDS=

# ---------------------------------------------------------------- public sources
# Register at https://stackapps.com to lift 300/day to 10,000/day
STACKAPPS_KEY=
GITHUB_TOKEN=

# ---------------------------------------------------------------- topology / network
# The NAS (Mac mini) IP, for the network preflight group
NAS_HOST=
# Another node's brain API, to prove cross-network reachability e.g. http://100.x.y.z:8077
BRAIN_PEER_URL=

# ---------------------------------------------------------------- file share / NAS
# Mounted paths to index. Comma or colon separated. Mount them READ-ONLY.
# NEVER point BRAIN_DB at a network share: SQLite WAL locking over SMB/NFS corrupts it.
# See docs/NAS-INGEST.md.
BRAIN_FILE_ROOTS=
BRAIN_FILE_MAX_MB=25
BRAIN_CSV_SAMPLE_ROWS=15
# how many rotated snapshots promote-db.sh --to keeps
BRAIN_BACKUP_KEEP=7

# ---------------------------------------------------------------- nightarc / sql express
NIGHTARC_SERVER=localhost\SQLEXPRESS
NIGHTARC_DB=NightArc
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# leave user/password blank to use Windows integrated auth
NIGHTARC_USER=
NIGHTARC_PASSWORD=

# ---------------------------------------------------------------- api
# REQUIRED. The API now refuses every request while this is blank or "change-me".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_API_KEY=change-me
BRAIN_PUBLIC_URL=http://localhost:8077
# Local development only: allow the API to run with no key at all.
BRAIN_ALLOW_NO_KEY=

# ---------------------------------------------------------------- website (site/)
# Origins allowed to call the API from a browser, comma separated.
BRAIN_CORS_ORIGINS=https://your-site.netlify.app
# 1 turns on /public/search: public forum sources only, sensitive-tagged results
# dropped, no key needed. Leave blank to keep it off.
BRAIN_PUBLIC_DEMO=
# per-IP requests per minute on /public/search
BRAIN_PUBLIC_RPM=10

# ---------------------------------------------------------------- foundry
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# ---------------------------------------------------------------- embeddings providers
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_EMBED_DEPLOYMENT=
