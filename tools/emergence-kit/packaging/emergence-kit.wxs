<!--
  Emergence Review Kit - Windows Installer (WiX Toolset v5).

  Built by packaging/build_windows.ps1 (and CI). Per-machine install to
  C:\Program Files\Ecomsp\EmergenceKit, added to the system PATH, upgrades in place.

  Silent install / uninstall (Intune, SCCM, scripts):
    msiexec /i EmergenceKit-<ver>-x64.msi /qn /norestart /l*v install.log
    msiexec /x EmergenceKit-<ver>-x64.msi /qn /norestart

  UpgradeCode is fixed FOREVER: it is how Windows knows a new MSI replaces the old
  one. Never change it. The product code is generated per build.

  ffmpeg is deliberately NOT bundled (GPL builds with x264 carry obligations we
  don't take on). Deploy it as a separate package - see docs/deploy/INTUNE.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Ecomsp Survey Studio"
           Manufacturer="Ecomsp Labs"
           Version="$(var.Version)"
           UpgradeCode="{CCAA7303-2B06-459F-BCED-2005075D0063}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Survey Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Bat emergence survey video review: import, review, QA, report." />
    <Icon Id="StudioIcon" SourceFile="$(var.IconFile)" />

    <!-- Setup wizard for people installing by hand: welcome and licence, progress,
         then "Open Survey Studio now". Silent installs (/qn, Intune) show none of it. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenceRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Survey Studio now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]survey-studio.exe" />
    <CustomAction Id="LaunchSurveyStudio" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSurveyStudio"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <Property Id="ARPPRODUCTICON" Value="StudioIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorFolder" Name="Ecomsp">
        <Directory Id="INSTALLFOLDER" Name="EmergenceKit" />
      </Directory>
    </StandardDirectory>

    <!-- Everything PyInstaller produced (onedir build). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <!-- System PATH entry + a registry value IT can use as a detection rule. -->
    <Component Id="PathAndRegistry" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\Ecomsp\EmergenceKit"
                     Name="Version" Type="string" Value="$(var.Version)" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Ecomsp\EmergenceKit"
                     Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      <Environment Id="AddToPath" Name="PATH" Value="[INSTALLFOLDER]"
                   Part="last" Action="set" System="yes" Permanent="no" />
    </Component>

    <!-- Start menu and desktop shortcuts for everyone on the machine. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Ecomsp" />
    </StandardDirectory>
    <Component Id="StudioShortcuts" Directory="AppMenuFolder">
      <Shortcut Id="StudioStartMenu" Name="Survey Studio" Description="Review bat emergence survey video"
                Target="[INSTALLFOLDER]survey-studio.exe" WorkingDirectory="INSTALLFOLDER" Icon="StudioIcon" />
      <Shortcut Id="StudioDesktop" Directory="DesktopFolder" Name="Survey Studio"
                Description="Review bat emergence survey video"
                Target="[INSTALLFOLDER]survey-studio.exe" WorkingDirectory="INSTALLFOLDER" Icon="StudioIcon" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <!-- Windows Installer's validation (ICE38/ICE43/ICE57) requires a shortcut
           component's key path to be a per-user registry value, even in a per-machine
           install. It's only a marker; detection rules use the HKLM Version value. -->
      <RegistryValue Root="HKCU" Key="Software\Ecomsp\SurveyStudio" Name="Shortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Survey Studio" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="PathAndRegistry" />
      <ComponentRef Id="StudioShortcuts" />
    </Feature>
  </Package>
</Wix>
